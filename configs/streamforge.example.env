# Every binary reads these as flag defaults (12-factor). Flags override env.
SF_BROKER=redpanda
SF_BROKERS=localhost:19092
SF_TOPIC=events
SF_PARTITIONS=6
# Kafka transport/authentication is optional. Configure credentials in your
# secret manager or local environment, not in this example file.
# SF_KAFKA_TLS=true
# SF_KAFKA_TLS_CA=/etc/streamforge/kafka-ca.pem
# SF_KAFKA_TLS_CERT=/etc/streamforge/client.crt
# SF_KAFKA_TLS_KEY=/etc/streamforge/client.key
# SF_KAFKA_TLS_SERVER_NAME=kafka.example.internal
# SF_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# SF_KAFKA_SASL_USERNAME=
# SF_KAFKA_SASL_PASSWORD=
SF_STORE=clickhouse
SF_CLICKHOUSE_URL=http://localhost:8123
SF_CLICKHOUSE_DB=streamforge
SF_CLICKHOUSE_USER=streamforge
SF_CLICKHOUSE_PASSWORD=streamforge
SF_API_ADDR=:8080
