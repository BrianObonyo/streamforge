{
 "uid": "streamforge",
 "title": "StreamForge",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "streamforge"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Throughput by outcome (events/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(sf_events_processed_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Processing latency (broker append \u2192 handled)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sf_process_latency_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sf_process_latency_seconds_bucket[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(sf_process_latency_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queue depth per partition",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sf_queue_depth",
     "legendFormat": "{{member}}/p{{partition}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Partitions paused by backpressure",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sf_paused_partitions)",
     "legendFormat": "paused"
    },
    {
     "refId": "B",
     "expr": "sum(sf_throttle_rate)",
     "legendFormat": "AIMD rate"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Window rows written (first vs late update)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(sf_window_results_total[1m]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Sink errors & circuit breaker retries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sf_sink_errors_total[1m]))",
     "legendFormat": "sink errors/s"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Dead-lettered messages / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sf_dlq_messages_total[1m]))",
     "legendFormat": "dlq/s"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Rebalances & commits",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sf_rebalances_total[5m]))",
     "legendFormat": "rebalances/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(sf_offset_commits_total[1m]))",
     "legendFormat": "commits/s"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Open windows held in memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (member) (sf_open_windows)",
     "legendFormat": "{{member}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Late-arrival share of events",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sf_events_processed_total{outcome=\"late\"}[1m])) / sum(rate(sf_events_processed_total{outcome=~\"on_time|late|too_late\"}[1m]))",
     "legendFormat": "late fraction"
    },
    {
     "refId": "B",
     "expr": "sum(rate(sf_events_processed_total{outcome=\"too_late\"}[1m])) / sum(rate(sf_events_processed_total{outcome=~\"on_time|late|too_late\"}[1m]))",
     "legendFormat": "dropped fraction"
    }
   ]
  }
 ]
}